{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd frontend && npm install",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/out",
  "redirects": [
    { "source": "/", "destination": "/uk/uk-cliff-watch", "permanent": false }
  ],
  "rewrites": [
    { "source": "/uk/uk-cliff-watch/api/:path*", "destination": "/api/:path*" },
    { "source": "/uk/uk-cliff-watch", "destination": "/index.html" },
    { "source": "/uk/uk-cliff-watch/:path*", "destination": "/:path*" }
  ],
  "functions": {
    "api/calculate.py":  { "maxDuration": 60 },
    "api/series.py":     { "maxDuration": 60 },
    "api/regions.py":    { "maxDuration": 60 },
    "api/households.py": { "maxDuration": 60 },
    "api/metadata.py":   { "maxDuration": 10 }
  }
}
